# @crit-fumble scope is published to GitHub Packages.
#
# This line only names the registry — it does NOT bind a token to it, so
# exporting NODE_AUTH_TOKEN on its own is not enough and installs 401 with
# "authentication token not provided".
#
# CI: .github/workflows/test.yml uses actions/setup-node's registry-url +
#     scope, which writes the //npm.pkg.github.com/:_authToken line for you,
#     and passes NODE_AUTH_TOKEN from secrets.GITHUB_TOKEN.
# Local: bind it on the command, e.g.
#     env "npm_config_//npm.pkg.github.com/:_authToken=$(gh auth token)" npm ci
@crit-fumble:registry=https://npm.pkg.github.com

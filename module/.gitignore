# Dependencies
# No trailing slash: `node_modules/` matches directories only, so a symlink
# named node_modules slips past it and gets committed. A self-referential one
# puts an infinite loop on PATH via node_modules/.bin and every bare command
# dies with ELOOP — npm exits 194 with no output. Cost two outages already.
node_modules
**/node_modules

# Build outputs
dist/

# Test artefacts
coverage/
test-results/
playwright-report/
playwright/.cache/

# OS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Husky internals (auto-managed by husky)
.husky/_

# Local env
.env
.env.local
.env.*.local

# Foundry integration tests — local secrets, GM auth state, Foundry runtime data,
# and scratch discovery scripts. Only the world.json template + compose are tracked.
# The world is copied to .worlds-runtime/ at `test:foundry:up`; Foundry mutates
# that copy (lastPlayed, data dirs) so the tracked template stays pristine.
tests/.env.test
tests/.auth/
tests/fixtures/.worlds-runtime/
# Local Foundry runtime assets for the compose mounts (FOUNDRY_SYSTEMS_DIR /
# FOUNDRY_CACHE_DIR): downloaded game systems + the felddy release cache.
tests/fixtures/.systems/
tests/fixtures/.cache/
tests/fixtures/worlds/README.txt
tests/fixtures/worlds/*/data/
tests/_*.mjs
tests/_*.png
tests/**/_*.mjs
tests/**/_*.png

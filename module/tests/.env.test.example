## Foundry Plugin — Integration Test Environment
## Copy to .env.test and fill in values before running integration tests.
## .env.test is gitignored — never commit real credentials.

## FoundryVTT credentials (felddy/foundryvtt image)
FOUNDRY_LICENSE_KEY=
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
FOUNDRY_ADMIN_KEY=cfgtestadmin

## Core platform — local dev stack (npm run dev)
## Use http://localhost:10001 when testing against the local dev stack,
## or a staging URL when testing against staging.
CORE_API_URL=http://localhost:10001

## Test campaign — must exist in the Core environment above.
## If blank, globalSetup will create one automatically (requires CORE_ADMIN_API_KEY).
CORE_TEST_CAMPAIGN_ID=

## CFG API key for self-hosted integration tests.
## Generate at: core.crit-fumble.com → Account → API Keys
## The key must have access to CORE_TEST_CAMPAIGN_ID.
CORE_TEST_API_KEY=

## (Optional) Admin API key used by globalSetup to create a test campaign.
## Only needed if CORE_TEST_CAMPAIGN_ID is blank.
CORE_ADMIN_API_KEY=
